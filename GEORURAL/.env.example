# Destino do proxy de desenvolvimento (nao e exposto ao navegador).
BACKEND_URL=http://localhost:8080

# Login local sem redirecionamento (cliente público com Direct Access Grants).
# Configuração existente no realm da branch US#13; não requer client secret.
AUTH_SERVER_URL=http://localhost:8180
VITE_AUTH_URL=/auth
VITE_KEYCLOAK_REALM=georural
VITE_KEYCLOAK_CLIENT_ID=georural-cli

# Em produção, o servidor web deve encaminhar /api e /auth aos serviços.
# Não coloque segredos ou senhas em variáveis VITE_*.

# Em producao, informe a origem publica do backend, sem /api no final.
# VITE_API_URL=https://backend.exemplo.com
